<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.lostfound.mapper.CommentMapper">
    <resultMap id="BaseResultMap" type="com.example.lostfound.entity.Comment">
        <id column="comment_id" property="commentId"/>
        <result column="post_id" property="postId"/>
        <result column="user_id" property="userId"/>
        <result column="content" property="content"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectByPostId" resultMap="BaseResultMap">
        select * from comment where post_id = #{postId} order by create_time desc
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        select * from comment where comment_id = #{commentId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="commentId">
        insert into comment(post_id,user_id,content,create_time)
        values(#{postId},#{userId},#{content},#{createTime})
    </insert>

    <delete id="deleteById">
        delete from comment where comment_id = #{commentId}
    </delete>
</mapper>
